# نخستین حساب مدیر. فقط وقتی جدول کاربران خالی باشد ساخته می‌شود؛
# بعد از ساخته شدن حساب، می‌توانید این دو را بردارید.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=مدیر

# مسیر فایل دیتابیس. پیش‌فرض ./data/artaclean.db
# روی سرور آن را بیرون از پوشه پروژه بگذارید تا دیپلوی پاکش نکند.
# DATABASE_PATH=/var/lib/artaclean/artaclean.db

# آدرس سایت، برای canonical و sitemap
# SITE_URL=https://example.com
